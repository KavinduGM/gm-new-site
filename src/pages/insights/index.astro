---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CloseCta from '../../components/CloseCta.astro';
import { EVIDENCE } from '../../data/content.mjs';
import { breadcrumbSchema } from '../../lib/schema.mjs';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/** A featured entry leads regardless of date — the case study is the thing the
 *  rest of the section argues from, so it should not fall down the list as
 *  commentary on it accumulates. */
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== lead);

/** ISO dates throughout the index — the console reads one format everywhere. */
const iso = (d: Date) => d.toISOString().slice(0, 10);
const n = (v: number) => v.toLocaleString('en-US');

/** Facts about the evidence file itself. "One account" is deliberately on the
 *  page: a reader who is going to find that out anyway should find it here. */
const strip = [
  { k: 'Entries', v: String(posts.length).padStart(2, '0') },
  { k: 'Accounts measured', v: String(EVIDENCE.accounts).padStart(2, '0') },
  { k: 'Period on record', v: `${EVIDENCE.from} → ${EVIDENCE.to}` },
  { k: 'Pieces in the dataset', v: n(EVIDENCE.produced) },
];

const arrow = 'M1 6h9M6.5 2 10.5 6l-4 4';
---

<Base
  title="Measured results from real production"
  description="Four months of recorded production on a live account, and what the figures do and do not prove — cost per usable piece, person-hours, energy."
  schema={[breadcrumbSchema([{ name: 'Insights', href: '/insights/' }])]}
  hideFooterCta
>
  <!-- ================================================== HERO -->
  <section class="hero grid-bg" aria-labelledby="insights-title">
    <span class="bloom hero__bloom" aria-hidden="true"></span>
    <div class="wrap wrap--wide">
      <p class="eyebrow eyebrow--center">Insights</p>
      <h1 id="insights-title" class="display-1 hero__title">
        Proof, with the <span class="hl">working shown</span>.
      </h1>
      <p class="lede hero__lede">
        Most efficiency claims in this market have no before. We have one, because we ran the
        account by hand first — then built the system that replaced most of that work, and
        measured both across four months.
      </p>
      <ul role="list" class="strip">
        {strip.map((s) => (
          <li class="strip__item">
            <span class="strip__k">{s.k}</span>
            <span class="strip__v">{s.v}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================================================== LEAD ENTRY -->
  {lead && (
    <section class="section section--sm section--ruled" aria-labelledby="lead-title">
      <div class="wrap wrap--wide">
        <article class="lead">
          <a href={`/insights/${lead.id}/`} class="lead__media" tabindex="-1" aria-hidden="true">
            <img
              class="lead__img"
              src={lead.data.cover}
              alt=""
              width="1600"
              height="800"
              loading="eager"
            />
          </a>

          <div class="lead__text">
            <p class="lead__kicker">
              <span class="lead__flag">
                <span class="dot dot--done" aria-hidden="true"></span>{lead.data.kind}
              </span>
              <span class="lead__sep" aria-hidden="true">/</span>
              <time datetime={iso(lead.data.date)}>{iso(lead.data.date)}</time>
              <span class="lead__sep" aria-hidden="true">/</span>
              <span>{lead.data.readingTime} min read</span>
            </p>

            <h2 id="lead-title" class="lead__title">
              <a href={`/insights/${lead.id}/`} class="lead__link">{lead.data.title}</a>
            </h2>
            <p class="lead__desc">{lead.data.description}</p>

            {lead.data.headline && (
              <p class="lead__fig">
                <span class="lead__fig-v">{lead.data.headline}</span>
                <span class="lead__fig-k">{lead.data.headlineLabel}</span>
              </p>
            )}

            <p class="lead__src">
              <span class="lead__src-k">Source</span>
              <span class="lead__src-v">{lead.data.source}</span>
            </p>

            <span class="link-arrow lead__cta">
              Read the case study
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
            </span>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- ================================================== CARD GRID -->
  {rest.length > 0 && (
    <section class="section section--ruled" aria-labelledby="more-title">
      <div class="wrap wrap--wide">
        <h2 id="more-title" class="sr-only">More entries from the same records</h2>

        <ul role="list" class="cards">
          {rest.map((post) => (
            <li class="card-e">
              <a href={`/insights/${post.id}/`} class="card-e__media" tabindex="-1" aria-hidden="true">
                <img
                  class="card-e__img"
                  src={post.data.cover}
                  alt=""
                  width="1600"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="card-e__text">
                <p class="card-e__kicker">
                  <span class="card-e__kind">{post.data.kind}</span>
                  <span class="lead__sep" aria-hidden="true">/</span>
                  <time datetime={iso(post.data.date)}>{iso(post.data.date)}</time>
                  <span class="lead__sep" aria-hidden="true">/</span>
                  <span>{post.data.readingTime} min</span>
                </p>
                <h3 class="card-e__title">
                  <a href={`/insights/${post.id}/`} class="card-e__link">{post.data.title}</a>
                </h3>
                <p class="card-e__desc">{post.data.description}</p>
                {post.data.headline && (
                  <p class="card-e__fig">
                    <span class="card-e__fig-v">{post.data.headline}</span>
                    <span class="card-e__fig-k">{post.data.headlineLabel}</span>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>

        <p class="feed">
          Every entry above is drawn from the same four months of records.
        </p>
      </div>
    </section>
  )}

  <!-- ================================================== EMPTY STATE -->
  {posts.length === 0 && (
    <section class="section section--ruled" aria-labelledby="empty-title">
      <div class="wrap wrap--wide">
        <div class="empty panel panel--pad-lg hatch ticked">
          <p class="eyebrow">Index</p>
          <h2 id="empty-title" class="display-4">Nothing published yet.</h2>
          <p class="body empty__text">
            The first entries are being written. Until they land, the arguments they cover
            are already set out across the site: the build decisions on
            <a href="/system/" class="link">the system</a> page, and the data map on
            <a href="/trust/" class="link">trust</a>.
          </p>
          <a href="/contact/" class="link-arrow">
            Ask us directly
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <CloseCta
    title="Want these numbers run against [your own account]?"
    body="Bring your monthly volume, your current headcount and your rejection rate to the call. We will tell you plainly whether a build moves them at your size, or whether it does not."
  />
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 6vw, 6.5rem) clamp(2.5rem, 1.8rem + 3vw, 4rem);
    overflow: clip;
    text-align: center;
  }
  /* Centred, so the bloom sits behind the title rather than off to one side. */
  .hero__bloom {
    inline-size: min(44rem, 92vw);
    block-size: 26rem;
    inset-block-start: -13rem;
    inset-inline-start: 50%;
    translate: -50% 0;
  }
  /* The shared margin-inline:auto and house measures do the centring; this
     hero only sets the rhythm between the three blocks. */
  .hero__title { margin-block-start: var(--sp-2); }
  .hero__lede { margin-block-start: var(--sp-5); }

  .strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-4);
    margin-block-start: var(--sp-7);
    padding-block-start: var(--sp-5);
    border-block-start: 1px solid var(--c-line);
  }
  @media (min-width: 34em) { .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 62em) { .strip { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .strip__item { display: flex; flex-direction: column; align-items: center; gap: var(--sp-2); }
  .strip__k {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .strip__v {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tr-wide);
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Shared card chrome ----
     The cover is a second link to the same entry, so it is hidden from the
     accessibility tree and taken out of the tab order: a keyboard user would
     otherwise stop twice on every card for one destination. */
  .lead__media,
  .card-e__media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-3);
    background: var(--c-panel);
  }
  .lead__img,
  .card-e__img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .lead:hover .lead__img,
  .card-e:hover .card-e__img { transform: scale(1.02); }

  .lead__sep { color: var(--c-ink-4); }

  /* ---- Lead entry ---- */
  .lead { display: grid; gap: clamp(1.5rem, 1rem + 2.4vw, 3rem); align-items: center; }
  @media (min-width: 62em) {
    .lead { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  }
  .lead__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-4); }

  .lead__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  .lead__flag {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--c-signal-text);
  }

  .lead__title {
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    font-weight: 500;
    color: var(--c-ink);
    text-wrap: balance;
  }
  .lead__link { transition: color var(--dur-2) var(--ease-out); }
  .lead:hover .lead__link { color: var(--c-signal); }
  .lead__desc {
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--c-ink-2);
    text-wrap: pretty;
  }

  /* The figure is the reason to read it, so it is set as one rather than
     buried inside the description. */
  .lead__fig,
  .card-e__fig {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-3);
  }
  .lead__fig-v,
  .card-e__fig-v {
    font-family: var(--font-mono);
    color: var(--c-signal-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tr-wide);
  }
  .lead__fig-v { font-size: var(--fs-md); }
  .card-e__fig-v { font-size: var(--fs-sm); }
  .lead__fig-k,
  .card-e__fig-k {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  .lead__src {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--c-line);
    inline-size: 100%;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    line-height: var(--lh-relaxed);
  }
  .lead__src-k {
    flex: none;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .lead__src-v { color: var(--c-ink-2); letter-spacing: var(--tr-wide); }
  .lead:hover .lead__cta { gap: var(--sp-3); }

  /* ---- Card grid ---- */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1.2rem + 3vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 46em) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .card-e { display: flex; flex-direction: column; gap: var(--sp-5); }
  .card-e__text { display: flex; flex-direction: column; gap: var(--sp-3); }
  .card-e__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  .card-e__kind { color: var(--c-signal-text); }
  .card-e__title {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-tight);
    font-weight: 500;
    color: var(--c-ink);
    text-wrap: pretty;
  }
  .card-e__link { transition: color var(--dur-2) var(--ease-out); }
  .card-e:hover .card-e__link { color: var(--c-signal); }
  .card-e__desc {
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--c-ink-2);
    text-wrap: pretty;
  }

  .feed {
    margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
    padding-block-start: var(--sp-5);
    border-block-start: 1px solid var(--c-line);
    font-size: var(--fs-sm);
    color: var(--c-ink-3);
  }

  /* ---- Empty state ---- */
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-4); }
  .empty__text { max-width: 44rem; }
</style>
