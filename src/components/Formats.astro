---
import { FORMATS } from '../data/content.mjs';

/**
 * The output formats, drawn at their true aspect ratio.
 *
 * The point of the section is that the shapes do the explaining: every preview
 * gets the same height and takes its width from `aspect-ratio: w / h`, so a
 * 9:16 short is visibly narrow beside a 16:9 master and nobody has to parse a
 * ratio in text. Because the shape is computed from the same numbers as the
 * label, the picture cannot drift from the caption.
 *
 * Schematic, not mockups: bands and blocks rather than invented screenshots of
 * client work that does not exist.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
}
const {
  eyebrow = 'What comes out',
  title = 'One run. Every file your [channels ask for].',
  lede =
    'Not one master a person then reformats four times. Each of these is produced ' +
    'in the same run, at the spec the platform enforces.',
} = Astro.props;

const parts = title.split(/\[([^\]]+)\]/).map((t, i) => ({ t, hl: i % 2 === 1 }));
---

<section class="section fmt-sec" aria-labelledby="fmt-title">
  <div class="wrap wrap--wide">
    <p class="eyebrow eyebrow--center">{eyebrow}</p>
    <h2 id="fmt-title" class="fmt__h">
      {parts.map((p) => (p.hl ? <span class="hl">{p.t}</span> : p.t))}
    </h2>
    <p class="fmt__lede"><Fragment set:html={lede} /></p>

    <ul role="list" class="fmt">
      {FORMATS.map((f) => (
        <li class="fmt__card panel ticked">
          <div class="fmt__stage">
            <div class="fmt__frame" style={`aspect-ratio:${f.w}/${f.h}`} aria-hidden="true">
              {f.kind === 'video' && (
                <>
                  <span class="fmt__play"></span>
                  <span class="fmt__strip">
                    <span class="fmt__seg fmt__seg--cap"></span>
                    <span class="fmt__seg fmt__seg--body"></span>
                    <span class="fmt__seg fmt__seg--cap"></span>
                  </span>
                </>
              )}
              {f.kind === 'thumb' && (
                <>
                  <span class="fmt__subject"></span>
                  <span class="fmt__hed"></span>
                  <span class="fmt__hed fmt__hed--short"></span>
                </>
              )}
              {f.kind === 'post' && (
                <>
                  <span class="fmt__tile"></span>
                  <span class="fmt__line"></span>
                  <span class="fmt__line fmt__line--short"></span>
                </>
              )}
              {f.kind === 'graphic' && (
                <>
                  <span class="fmt__hed2"></span>
                  <span class="fmt__hed2 fmt__hed2--b"></span>
                  <span class="fmt__sub"></span>
                  <span class="fmt__mark2"></span>
                </>
              )}
              {f.kind === 'article' && (
                <>
                  <span class="fmt__cover"></span>
                  <span class="fmt__para fmt__para--1"></span>
                  <span class="fmt__para fmt__para--2"></span>
                  <span class="fmt__inner"></span>
                  <span class="fmt__para fmt__para--3"></span>
                </>
              )}
            </div>
          </div>

          <p class="fmt__ratio">{f.ratio}</p>
          <h3 class="fmt__name">{f.name}</h3>
          <p class="fmt__d">{f.d}</p>
          <p class="fmt__for">{f.for}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Astro scopes styles per file, so a page's .sec__title rule cannot reach
     this heading. Restated to match the house heading exactly. */
  .fmt__h {
    margin-inline: auto;
    font-size: var(--fs-section);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    font-weight: 600;
    max-width: 44rem;
    text-align: center;
    text-wrap: balance;
  }
  .fmt__lede {
    margin: var(--sp-5) auto 0;
    max-width: 46rem;
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--c-ink-2);
    text-align: center;
    text-wrap: pretty;
  }

  .fmt {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-4);
    list-style: none;
    margin: clamp(2rem, 1.4rem + 2vw, 3rem) 0 0;
    padding: 0;
  }
  @media (min-width: 40em) { .fmt { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68em) { .fmt { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .fmt__card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: clamp(1.25rem, 0.9rem + 1.4vw, 1.75rem);
    /* .panel resolves to --c-panel, which equals the .section--raised
       background wherever this is dropped onto one. Lift a step so the cards
       always read as objects. */
    background:
      linear-gradient(180deg, rgb(255 255 255 / 2.2%) 0%, transparent 46%),
      var(--c-panel-2);
    border-color: var(--c-line-2);
  }

  /* Fixed-height stage, so every preview shares a baseline and only the WIDTH
     changes with the ratio — which is the whole comparison. */
  .fmt__stage {
    display: grid;
    place-items: center;
    block-size: 8.5rem;
    margin-block-end: var(--sp-3);
    border-radius: var(--r-1);
    background:
      radial-gradient(ellipse 70% 76% at 50% 50%, var(--c-signal-wash), transparent 72%),
      var(--c-panel);
    border: 1px solid var(--c-line);
  }
  .fmt__frame {
    position: relative;
    block-size: 6.5rem;
    inline-size: auto;
    border: 1px solid var(--c-line-signal);
    border-radius: 2px;
    background: var(--c-panel-3);
    overflow: hidden;
  }

  /* ---- video ---- */
  .fmt__play {
    position: absolute;
    inset-block-start: 42%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    inline-size: 0;
    block-size: 0;
    border-block: 7px solid transparent;
    border-inline-start: 11px solid var(--c-signal);
  }
  .fmt__strip {
    position: absolute;
    inset-inline: 8%;
    inset-block-end: 10%;
    display: flex;
    gap: 2px;
    block-size: 5px;
  }
  .fmt__seg { display: block; border-radius: 1px; }
  .fmt__seg--cap { flex: 0 0 18%; background: var(--c-signal); }
  .fmt__seg--body { flex: 1 1 auto; background: var(--c-ink-4); }

  /* ---- thumbnail ---- */
  .fmt__subject {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 8%;
    inline-size: 32%;
    block-size: 58%;
    border-radius: 50% 50% 0 0;
    background: var(--c-ink-4);
  }
  .fmt__hed {
    position: absolute;
    inset-inline-start: 9%;
    inset-block-start: 26%;
    inline-size: 46%;
    block-size: 9px;
    border-radius: 1px;
    background: var(--c-signal);
  }
  .fmt__hed--short { inset-block-start: 46%; inline-size: 30%; background: var(--c-ink-2); }

  /* ---- post: photo led ---- */
  .fmt__tile {
    position: absolute;
    inset-inline: 10%;
    inset-block-start: 10%;
    block-size: 46%;
    border-radius: 2px;
    background: var(--c-ink-4);
  }
  .fmt__line {
    position: absolute;
    inset-inline-start: 10%;
    inset-block-start: 66%;
    inline-size: 62%;
    block-size: 4px;
    border-radius: 1px;
    background: var(--c-ink-3);
  }
  .fmt__line--short { inset-block-start: 78%; inline-size: 40%; }

  /* ---- graphic: type led, so it does not read as another photo post ---- */
  .fmt__hed2 {
    position: absolute;
    inset-inline-start: 12%;
    inset-block-start: 16%;
    inline-size: 62%;
    block-size: 8px;
    border-radius: 1px;
    background: var(--c-signal);
  }
  .fmt__hed2--b { inset-block-start: 30%; inline-size: 44%; }
  .fmt__sub {
    position: absolute;
    inset-inline-start: 12%;
    inset-block-start: 48%;
    inline-size: 54%;
    block-size: 4px;
    border-radius: 1px;
    background: var(--c-ink-3);
  }
  .fmt__mark2 {
    position: absolute;
    inset-inline-start: 12%;
    inset-block-end: 12%;
    inline-size: 14px;
    block-size: 14px;
    border-radius: 3px;
    border: 1px solid var(--c-ink-4);
  }

  /* ---- article: a page, with its own paragraph rhythm ---- */
  .fmt__cover {
    position: absolute;
    inset-inline: 12%;
    inset-block-start: 8%;
    block-size: 24%;
    border-radius: 2px;
    background: var(--c-signal);
    opacity: 0.55;
  }
  .fmt__para {
    position: absolute;
    inset-inline-start: 12%;
    block-size: 3px;
    border-radius: 1px;
    background: var(--c-ink-3);
  }
  .fmt__para--1 { inset-block-start: 39%; inline-size: 62%; }
  .fmt__para--2 { inset-block-start: 47%; inline-size: 46%; }
  .fmt__para--3 { inset-block-start: 84%; inline-size: 52%; }
  .fmt__inner {
    position: absolute;
    inset-inline: 12%;
    inset-block-start: 58%;
    block-size: 18%;
    border-radius: 2px;
    background: var(--c-ink-4);
  }

  /* ---- captions ---- */
  .fmt__ratio {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--c-signal-text);
  }
  .fmt__name {
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: var(--tr-display);
    color: var(--c-ink);
  }
  .fmt__d {
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--c-ink-2);
    text-wrap: pretty;
  }
  .fmt__for {
    margin-block-start: auto;
    padding-block-start: var(--sp-3);
    border-block-start: 1px solid var(--c-line);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tr-wide);
    color: var(--c-ink-3);
  }
</style>
