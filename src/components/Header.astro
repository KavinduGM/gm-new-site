---
import { NAV, SITE } from '../site.config.mjs';
import Logo from './Logo.astro';

/* Both sides are normalised to a trailing slash before comparing. NAV hrefs
   carry one (so internal navigation hits the directory-format URL directly
   instead of taking a 301), and Astro.url.pathname may or may not, depending on
   how the visitor arrived. Comparing a stripped path against a slashed href is
   what silently broke the active state the first time this was changed.

   The startsWith test keeps section pages lit for their children — /insights/
   stays active on /insights/some-article/ — and the slash on both sides stops
   it matching a sibling that merely shares a prefix. */
const norm = (u: string) => (u.endsWith('/') ? u : u + '/');
const path = norm(Astro.url.pathname);
const isActive = (href: string) => {
  const h = norm(href);
  return path === h || (h !== '/' && path.startsWith(h));
};
---

<header class="hdr" id="site-header">
  <div class="wrap wrap--wide hdr__inner">
    <a href="/" class="hdr__brand" aria-label={`${SITE.name} — home`}>
      <Logo />
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul role="list" class="hdr__list">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['hdr__link', isActive(item.href) && 'is-active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="hdr__link-text">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a href="/contact/" class="btn btn--primary btn--lg hdr__cta">
        Book a build call
        <svg class="btn__arrow" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2 10.5 6l-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
      </a>
      <button
        type="button"
        class="hdr__burger"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Menu</span>
        <span class="hdr__burger-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  {/* Mobile navigation */}
  <div class="mnav" id="mobile-nav" hidden>
    <nav class="wrap mnav__inner" aria-label="Mobile">
      <ul role="list" class="mnav__list">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['mnav__link', isActive(item.href) && 'is-active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true" class="mnav__chev"><path d="M1 6h9M6.5 2 10.5 6l-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
            </a>
          </li>
        ))}
        <li>
          <a href="/about/" class:list={['mnav__link', isActive('/about') && 'is-active']} aria-current={isActive('/about') ? 'page' : undefined}><span>About</span>
            <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true" class="mnav__chev"><path d="M1 6h9M6.5 2 10.5 6l-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
          </a>
        </li>
      </ul>
      <a href="/contact/" class="btn btn--primary btn--lg btn--block mnav__cta">Book a build call</a>
    </nav>
  </div>
</header>

<style>
  /* ---- Header ---- */
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--c-void) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-block-end: 1px solid var(--c-line);
  }
  @supports not (backdrop-filter: blur(1px)) { .hdr { background: var(--c-void); } }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    block-size: var(--header-h);
  }
  .hdr__brand { display: inline-flex; align-items: center; flex: none; 
  /* The logo is the home link and therefore a real touch target, but it
     measured 30px tall inside an 85px header. The header has the room, so this
     costs no layout — it just makes the box match what people aim at. */
  min-block-size: 2.75rem;
}
  .hdr__brand:hover { opacity: 0.85; }

  .hdr__nav { display: none; }
  /* 77em (1232px), not the 73em it used to be. The row needs logo + nav + CTA
     + two 24px gaps + the wrap's 35.5px padding either side = 1219px. The nav
     was appearing 51px before it fitted, so the CTA pushed ~1px past the
     viewport and the page grew a horizontal scrollbar. Already wrong by 26px
     with the previous logo; the new wordmark is 25px wider at the same height,
     which doubled the bad band. Moving the logo's aspect ratio means
     re-checking this number. */
  @media (min-width: 77em) { .hdr__nav { display: block; } }

  .hdr__list { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }

  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: var(--sp-2h) var(--sp-3h);
    border-radius: var(--r-1);
    font-size: var(--fs-base);
    color: var(--c-ink-2);
    letter-spacing: var(--tr-normal);
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .hdr__link:hover { color: var(--c-ink); background: var(--c-panel-2); }
  .hdr__link.is-active { color: var(--c-ink); }
  /* Inset to the link's own padding, so the rule spans the word and not the
     hover box. Was hand-tuned to 0.8125rem when a mono index sat in front. */
  .hdr__link.is-active::after {
    content: '';
    position: absolute;
    inset-inline: var(--sp-3h);
    inset-block-end: -1px;
    block-size: 1px;
    background: var(--c-signal);
  }

  .hdr__actions { display: flex; align-items: center; gap: var(--sp-3); flex: none; }
  .hdr__cta { display: none; }
  @media (min-width: 48em) { .hdr__cta { display: inline-flex; } }

  /* ---- Burger ---- */
  .hdr__burger {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-2);
    background: var(--c-panel-2);
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .hdr__burger:hover { border-color: var(--c-line-strong); }
  @media (min-width: 77em) { .hdr__burger { display: none; } }

  .hdr__burger-bars { display: grid; gap: var(--sp-1); }
  .hdr__burger-bars i {
    display: block;
    inline-size: 16px;
    block-size: 1.5px;
    background: var(--c-ink);
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-1) linear;
  }
  .hdr__burger[aria-expanded='true'] .hdr__burger-bars i:first-child { transform: translateY(2.75px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] .hdr__burger-bars i:last-child { transform: translateY(-2.75px) rotate(-45deg); }

  /* ---- Mobile nav ---- */
  .mnav {
    border-block-start: 1px solid var(--c-line);
    background: var(--c-void);
    max-block-size: calc(100svh - var(--header-h) - 2rem);
    overflow-y: auto;
  }
  .mnav[hidden] { display: none; }
  .mnav__inner { padding-block: var(--sp-4) var(--sp-6); }
  .mnav__list { list-style: none; margin: 0 0 var(--sp-5); padding: 0; }
  .mnav__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-block-end: 1px solid var(--c-line);
    font-size: var(--fs-lg);
    letter-spacing: var(--tr-tight);
    color: var(--c-ink-2);
  }
  .mnav__chev { margin-inline-start: auto; color: var(--c-ink-4); }
  /* The mono index used to carry the signal colour on the current page. With
     it gone the active row needs its own mark, or ink vs ink-2 is the only
     difference and it is too quiet to read as "you are here". */
  .mnav__link.is-active { color: var(--c-ink); }
  .mnav__link.is-active::before {
    content: '';
    position: absolute;
    inset-block: var(--sp-2);
    inset-inline-start: calc(var(--sp-3) * -1);
    inline-size: 2px;
    background: var(--c-signal);
  }
  .mnav__cta { margin-block-start: var(--sp-2); }
</style>

<script>
  /* Not is:inline: as a bundled module this is minified and deferred, so it no
   longer blocks the parser partway down the document. Deferring is safe here —
   the script only attaches listeners, and a nav toggle that is inert for the
   first few milliseconds is not a regression. */
  (() => {
    const btn = document.getElementById('nav-toggle');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;

    const setOpen = (open) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || btn.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      btn.focus();
    });
    // Reset when the layout crosses into desktop territory.
    matchMedia('(min-width: 77em)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  })();
</script>
