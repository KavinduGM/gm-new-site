# Copy the KEYS (not this file) into Dokploy → your app → Environment.
# These are read at RUNTIME by server.mjs. Do not put them in Build Arguments:
# build args are readable in `docker history`, and Dokploy's Environment-tab
# values are not available during `docker build` anyway.
#
# Never prefix any of these with PUBLIC_ — Astro inlines PUBLIC_* into the
# browser bundle, which would publish the API key.

# Resend API key. Create at https://resend.com/api-keys with Sending access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The From address. Resend verifies DOMAINS, not individual senders: once
# groovymark.com is verified at https://resend.com/domains, any address at that
# domain works. A subdomain is NOT covered by the parent — verifying
# mail.groovymark.com does not authorise sending from @groovymark.com.
# Sending from an unverified domain returns 403 and the mail is not sent.
#
# Avoid a no-reply address: Resend's own deliverability guidance is that some
# providers weigh replies when filtering, and this address receives the
# sender's reply to the auto-reply.
RESEND_FROM=GroovyMark <hello@groovymark.com>

# Optional. Where enquiry notifications go. Defaults to SITE.leadsEmail
# (leads@groovymark.com) when unset, so it only needs setting to override.
# LEADS_TO=leads@groovymark.com

# Optional. server.mjs defaults to 0.0.0.0:3000, which is what the Dockerfile
# sets and what the Container Port field on the Dokploy domain should match.
# PORT=3000
# HOST=0.0.0.0
