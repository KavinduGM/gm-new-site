# Copy the KEYS (not this file) into Dokploy → your app → Environment.
# These are read at RUNTIME by server.mjs. Do not put them in Build Arguments:
# build args are readable in `docker history`, and Dokploy's Environment-tab
# values are not available during `docker build` anyway.
#
# Never prefix any of these with PUBLIC_ — Astro inlines PUBLIC_* into the
# browser bundle, which would publish the API key.

# Resend API key. Create at https://resend.com/api-keys with Sending access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The From address, and the one variable most likely to be set wrong.
#
# It must be at the domain VERIFIED IN RESEND, which is the SUBDOMAIN
# email.groovymark.com — not groovymark.com. A subdomain is not covered by its
# parent and a parent is not covered by its subdomain, so
# `leads@groovymark.com` here returns 403 on every send and no mail goes out.
# Check https://resend.com/domains before changing the part after the @.
#
# Avoid a no-reply address. Resend flags it, some providers weigh replies when
# filtering, and it reads badly to a prospect. It costs nothing to avoid: this
# address does not need to receive anything, because the auto-reply carries
# Reply-To: LEADS_TO and the team notification carries Reply-To: the enquirer.
RESEND_FROM=GroovyMark <hello@email.groovymark.com>

# Optional. Where enquiry notifications go. Defaults to SITE.leadsEmail
# (leads@groovymark.com) when unset, so it only needs setting to override.
# This address must be a REAL, RECEIVING mailbox. If it is not, Resend records
# hard bounces, adds it to the suppression list, and then answers 200 for
# messages it never attempts to send — see RESEND_WEBHOOK_SECRET below.
# LEADS_TO=leads@groovymark.com

# Strongly recommended. Signing secret from https://resend.com/webhooks, for a
# webhook pointed at https://groovymark.com/api/resend-webhook subscribed to
# email.bounced, email.failed, email.complained and email.delivery_delayed.
#
# Without it that route refuses every payload and a lead notification that
# bounces or is suppressed fails silently, exactly as it did before this
# existed. The site's own logs cannot tell you: Resend's 200 at send time says
# accepted, never delivered.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional but pointless to omit if the webhook is on. Where the "a lead was
# not delivered" alert goes. Put it at a DIFFERENT provider from LEADS_TO —
# the alert has to work in the case where the primary inbox is the broken
# thing, which is the only case that raises it.
# ALERT_TO=someone@gmail.com

# Optional. server.mjs defaults to 0.0.0.0:3000, which is what the Dockerfile
# sets and what the Container Port field on the Dokploy domain should match.
# PORT=3000
# HOST=0.0.0.0
